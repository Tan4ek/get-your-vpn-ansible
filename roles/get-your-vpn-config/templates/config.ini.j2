[get-your-vpn-config]
Host = {{ get_your_vpn_host }}

[openvpn-http-api]
Uri = http://{{ get_your_vpn_openvpn_container_name }}:8090

[outline-ss-server-user-manager]
Uri = http://{{ get_your_vpn_ss_container_name }}:8080

[vpn-metrics]
PrometheusUri = http://{{ get_your_vpn_prometheus_container_name }}:9090

[sqlite]
FilePath = get-your-vpn-config.sqlite3

[admin]
XApiKey = {{ get_your_vpn_config_api_key }}
